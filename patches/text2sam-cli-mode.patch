 AppState* app_state;
 
+// Timing record for the screen reader's speech calibration (tools/sam_calibrate.py in the
+// accessibility project): how many milliseconds the last utterance took to speak.
+static void save_timing(uint32_t ms) {
+    Storage* storage = (Storage*)furi_record_open(RECORD_STORAGE);
+    File* file = storage_file_alloc(storage);
+    if(storage_file_open(file, APP_DATA_PATH("timing.txt"), FSAM_WRITE, FSOM_CREATE_ALWAYS)) {
+        char line[32];
+        int n = snprintf(line, sizeof(line), "ms=%lu\n", (unsigned long)ms);
+        storage_file_write(file, line, n);
+    }
+    storage_file_close(file);
+    storage_file_free(file);
+    furi_record_close(RECORD_STORAGE);
+}
+
 static void say_something(char* something) {
     if(furi_hal_speaker_is_mine() || furi_hal_speaker_acquire(1000)) {
+        uint32_t started = furi_get_tick();
         voice.begin();
         voice.say(something);
+        uint32_t elapsed = furi_get_tick() - started;
         furi_hal_speaker_release();
+        save_timing(elapsed);
+    }
+}
+
+// Command-line mode, added for accessibility work:
+//   loader open /ext/apps/Media/text2sam.fap some text to speak
+//   loader open /ext/apps/Media/text2sam.fap !pitch,speed,mouth,throat some text
+// Defaults are pitch 64, speed 72, mouth 128, throat 128. Speaks and exits.
+static void say_from_args(const char* args) {
+    char text[TEXT_BUFFER_SIZE];
+    memset(text, 0, sizeof(text));
+    const char* s = args;
+    if(*s == '!') {
+        unsigned long v[4] = {64, 72, 128, 128};
+        s++;
+        for(int i = 0; i < 4 && *s && *s != ' '; i++) {
+            char* end = NULL;
+            v[i] = strtoul(s, &end, 10);
+            s = end;
+            if(*s == ',') s++;
+        }
+        while(*s == ' ') s++;
+        voice.setVoice(v[0] & 0xff, v[1] & 0xff, v[2] & 0xff, v[3] & 0xff);
     }
+    strncpy(text, s, TEXT_BUFFER_SIZE - 1);
+    FURI_LOG_I(TAG, "Speaking: %s", text);
+    say_something(text);
 }
 
 static void text_input_callback(void* ctx) {
