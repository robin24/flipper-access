+// Command-line mode, added for accessibility work:
+//   loader open /ext/apps/Media/text2sam.fap some text to speak
+//   loader open /ext/apps/Media/text2sam.fap !pitch,speed,mouth,throat some text
+// Defaults are pitch 64, speed 72, mouth 128, throat 128. Speaks and exits.
+static void say_from_args(const char* args) {
+    char text[TEXT_BUFFER_SIZE];
+    memset(text, 0, sizeof(text));
+    const char* s = args;
+    if(*s == '!') {
+        unsigned long v[4] = {64, 72, 128, 128};
+        s++;
+        for(int i = 0; i < 4 && *s && *s != ' '; i++) {
+            char* end = NULL;
+            v[i] = strtoul(s, &end, 10);
+            s = end;
+            if(*s == ',') s++;
+        }
+        while(*s == ' ') s++;
+        voice.setVoice(v[0] & 0xff, v[1] & 0xff, v[2] & 0xff, v[3] & 0xff);
+    }
+    strncpy(text, s, TEXT_BUFFER_SIZE - 1);
+    FURI_LOG_I(TAG, "Speaking: %s", text);
+    say_something(text);
+}
+
 static void text_input_callback(void* ctx) {
